{
  "name": "mergeflow",
  "displayName": "MergeFlow",
  "description": "A modern Git merge conflict resolver with a clean three-pane experience.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dharanikumar07/merge-conflict-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/dharanikumar07/merge-conflict-resolver/issues"
  },
  "homepage": "https://github.com/dharanikumar07/merge-conflict-resolver#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionDependencies": [
    "vscode.git"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "merge",
    "git",
    "conflict",
    "merge conflict",
    "conflict resolver",
    "three way merge",
    "source control",
    "developer tools"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "phpstorm-merge-sidebar",
          "title": "Merge Conflicts",
          "icon": "$(git-merge)"
        }
      ]
    },
    "views": {
      "phpstorm-merge-sidebar": [
        {
          "id": "mergeConflictsView",
          "name": "Merge Conflicts"
        }
      ]
    },
    "commands": [
      {
        "command": "phpstorm-merge.open",
        "title": "Open in Merge Resolver",
        "category": "MergeFlow",
        "icon": "$(git-merge)"
      },
      {
        "command": "phpstorm-merge.refresh",
        "title": "Refresh Conflicts",
        "category": "MergeFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "phpstorm-merge.nextConflict",
        "title": "Next Conflict",
        "category": "MergeFlow",
        "icon": "$(arrow-down)"
      },
      {
        "command": "phpstorm-merge.previousConflict",
        "title": "Previous Conflict",
        "category": "MergeFlow",
        "icon": "$(arrow-up)"
      },
      {
        "command": "phpstorm-merge.acceptYours",
        "title": "Accept Left (Yours)",
        "category": "MergeFlow",
        "icon": "$(arrow-right)"
      },
      {
        "command": "phpstorm-merge.acceptTheirs",
        "title": "Accept Right (Theirs)",
        "category": "MergeFlow",
        "icon": "$(arrow-left)"
      },
      {
        "command": "phpstorm-merge.acceptBoth",
        "title": "Accept Both (Yours, then Theirs)",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.ignoreYours",
        "title": "Ignore Left (Yours)",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.ignoreTheirs",
        "title": "Ignore Right (Theirs)",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.resolveSimple",
        "title": "Resolve Simple Conflict",
        "category": "MergeFlow",
        "icon": "$(wand)"
      },
      {
        "command": "phpstorm-merge.resolveAllSimple",
        "title": "Resolve All Simple Conflicts",
        "category": "MergeFlow",
        "icon": "$(wand)"
      },
      {
        "command": "phpstorm-merge.applyNonConflicting",
        "title": "Apply All Non-Conflicting Changes",
        "category": "MergeFlow",
        "icon": "$(check-all)"
      },
      {
        "command": "phpstorm-merge.applyNonConflictingYours",
        "title": "Apply Non-Conflicting Changes from Yours",
        "category": "MergeFlow",
        "icon": "$(arrow-right)"
      },
      {
        "command": "phpstorm-merge.applyNonConflictingTheirs",
        "title": "Apply Non-Conflicting Changes from Theirs",
        "category": "MergeFlow",
        "icon": "$(arrow-left)"
      },
      {
        "command": "phpstorm-merge.revertResolution",
        "title": "Revert Conflict Resolution",
        "category": "MergeFlow",
        "icon": "$(discard)"
      },
      {
        "command": "phpstorm-merge.compare",
        "title": "Compare...",
        "category": "MergeFlow",
        "icon": "$(git-compare)"
      },
      {
        "command": "phpstorm-merge.compareYoursTheirs",
        "title": "Compare Yours with Theirs",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.compareYoursBase",
        "title": "Compare Yours with Base",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.compareTheirsBase",
        "title": "Compare Theirs with Base",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.compareResultYours",
        "title": "Compare Result with Yours",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.compareResultTheirs",
        "title": "Compare Result with Theirs",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.compareResultBase",
        "title": "Compare Result with Base",
        "category": "MergeFlow"
      },
      {
        "command": "phpstorm-merge.completeMerge",
        "title": "Complete Merge",
        "category": "MergeFlow",
        "icon": "$(check)"
      },
      {
        "command": "phpstorm-merge.abortMerge",
        "title": "Abort Merge...",
        "category": "MergeFlow",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phpstorm-merge.nextConflict",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.previousConflict",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.acceptYours",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.acceptTheirs",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.acceptBoth",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.ignoreYours",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.ignoreTheirs",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.resolveSimple",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.resolveAllSimple",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.applyNonConflicting",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.applyNonConflictingYours",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.applyNonConflictingTheirs",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.revertResolution",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compare",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compareYoursTheirs",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compareYoursBase",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compareTheirsBase",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compareResultYours",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compareResultTheirs",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.compareResultBase",
          "when": "phpstormMerge.inSession"
        },
        {
          "command": "phpstorm-merge.completeMerge",
          "when": "phpstormMerge.inSession"
        }
      ],
      "editor/title": [
        {
          "command": "phpstorm-merge.open",
          "when": "resourceScheme == file && resourcePath in phpstormMerge.conflictedPaths",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "phpstorm-merge.open",
          "when": "resourceScheme == file && resourcePath in phpstormMerge.conflictedPaths",
          "group": "3_compare"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "phpstorm-merge.open",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline"
        },
        {
          "command": "phpstorm-merge.open",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "phpstorm-merge.refresh",
          "when": "view == mergeConflictsView",
          "group": "navigation"
        },
        {
          "command": "phpstorm-merge.abortMerge",
          "when": "view == mergeConflictsView",
          "group": "2_abort"
        }
      ],
      "view/item/context": [
        {
          "command": "phpstorm-merge.open",
          "when": "view == mergeConflictsView && viewItem == conflictedFile",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phpstorm-merge.nextConflict",
        "key": "f7",
        "when": "activeWebviewPanelId == 'phpstormMerge.mergeEditor'"
      },
      {
        "command": "phpstorm-merge.previousConflict",
        "key": "shift+f7",
        "when": "activeWebviewPanelId == 'phpstormMerge.mergeEditor'"
      }
    ],
    "configuration": {
      "title": "MergeFlow",
      "properties": {
        "phpstormMerge.autoApplyNonConflictingChanges": {
          "type": "boolean",
          "default": false,
          "description": "Apply all non-conflicting changes automatically when a file is opened in the merge resolver (like PhpStorm's \"Automatically apply non-conflicting changes\")."
        }
      }
    },
    "colors": [
      {
        "id": "phpstormMerge.conflictBackground",
        "description": "Background of unresolved conflicts in the merge editor.",
        "defaults": {
          "dark": "#4a2e2a",
          "light": "#ffe4dd",
          "highContrast": "#5a2f28",
          "highContrastLight": "#ffe4dd"
        }
      },
      {
        "id": "phpstormMerge.conflictWordBackground",
        "description": "Background of changed words inside conflicts.",
        "defaults": {
          "dark": "#713b33",
          "light": "#ffc3b4",
          "highContrast": "#713b33",
          "highContrastLight": "#ffc3b4"
        }
      },
      {
        "id": "phpstormMerge.conflictBorder",
        "description": "Outline and connector edge of conflicts.",
        "defaults": {
          "dark": "#a05a4c",
          "light": "#ef9a85",
          "highContrast": "#f28b76",
          "highContrastLight": "#ef9a85"
        }
      },
      {
        "id": "phpstormMerge.modifiedBackground",
        "description": "Background of modified lines (non-conflicting changes).",
        "defaults": {
          "dark": "#253a50",
          "light": "#dde8fb",
          "highContrast": "#1f3d5c",
          "highContrastLight": "#dde8fb"
        }
      },
      {
        "id": "phpstormMerge.modifiedWordBackground",
        "description": "Background of changed words inside modified lines.",
        "defaults": {
          "dark": "#2f5a88",
          "light": "#b8cef6",
          "highContrast": "#2f5a88",
          "highContrastLight": "#b8cef6"
        }
      },
      {
        "id": "phpstormMerge.modifiedBorder",
        "description": "Outline and connector edge of modified lines.",
        "defaults": {
          "dark": "#4c7db3",
          "light": "#86a9e6",
          "highContrast": "#7db3f5",
          "highContrastLight": "#86a9e6"
        }
      },
      {
        "id": "phpstormMerge.addedBackground",
        "description": "Background of added lines (non-conflicting changes).",
        "defaults": {
          "dark": "#263e2d",
          "light": "#dcf1dc",
          "highContrast": "#1f4a2a",
          "highContrastLight": "#dcf1dc"
        }
      },
      {
        "id": "phpstormMerge.addedWordBackground",
        "description": "Background of changed words inside added lines.",
        "defaults": {
          "dark": "#31633e",
          "light": "#b2deb2",
          "highContrast": "#31633e",
          "highContrastLight": "#b2deb2"
        }
      },
      {
        "id": "phpstormMerge.addedBorder",
        "description": "Outline and connector edge of added lines.",
        "defaults": {
          "dark": "#4c8b5b",
          "light": "#7bbf7b",
          "highContrast": "#77cc8a",
          "highContrastLight": "#7bbf7b"
        }
      },
      {
        "id": "phpstormMerge.deletedBackground",
        "description": "Background of lines a side deletes.",
        "defaults": {
          "dark": "#393c3e",
          "light": "#ececec",
          "highContrast": "#3a3a3a",
          "highContrastLight": "#ececec"
        }
      },
      {
        "id": "phpstormMerge.deletedWordBackground",
        "description": "Background of deleted words.",
        "defaults": {
          "dark": "#54585b",
          "light": "#d2d2d2",
          "highContrast": "#54585b",
          "highContrastLight": "#d2d2d2"
        }
      },
      {
        "id": "phpstormMerge.deletedBorder",
        "description": "Outline and connector edge of deleted lines.",
        "defaults": {
          "dark": "#737b81",
          "light": "#b1b1b1",
          "highContrast": "#b4bbc1",
          "highContrastLight": "#b1b1b1"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "compile": "tsc -p ./ && tsc -p src/webview",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "lint": "eslint src --ext ts",
    "test:e2e": "npm run compile && npm run bundle && node out/test/e2e/launch.js"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.70.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.20.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "diff": "^8.0.3"
  }
}
